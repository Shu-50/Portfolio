VITE_SERVICE_API_KEY=

# --- Supabase (content + file storage for /dev) ---
# Supabase dashboard -> Project Settings -> Data API / API Keys
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- /dev admin account ---
# Create this user in Supabase -> Authentication -> Users (tick "Auto Confirm User").
# The /dev passcode is 5050; these credentials are what actually authorise DB writes.
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=
